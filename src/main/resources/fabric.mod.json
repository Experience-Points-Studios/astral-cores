{
	"schemaVersion": 1,
	"id": "astralcores",
	"version": "${version}",
	"name": "Astral Cores",
	"description": "This Mod adds 12 custom items with powerful abilities into Minecraft.",
	"authors": [
		"Mr Panda",
		"aEternalCatGod"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/astral-cores",
		"sources": "https://github.com/Experience-Points-Studios/astral-cores"
	},
	"license": "MIT",
	"icon": "assets/astralcores/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.ep.astralcores.AstralCores"
		],
		"client": [
			"de.ep.astralcores.client.AstralCoresClient"
		],
		"fabric-datagen": [
			"de.ep.astralcores.datagen.AstralCoresDataGenerator"
		]
	},
	"mixins": [
		"astralcores.mixins.json",
		{
			"config": "astralcores.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}